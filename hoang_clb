-- Khởi tạo GUI
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/your-library/UILibrary/main/UILibrary.lua"))()
local Window = Library:CreateWindow("Blox Fruits Script")

-- Biến toàn cục
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Cấu hình
local AutoFarm = false
local AutoCollect = false
local TargetNPC = nil
local FarmRadius = 2000
local FarmDelay = 0.5

-- Danh sách các đảo theo cấp độ (cập nhật tọa độ thực tế)
local Islands = {
    {Name = "Pirate Starter", Level = 1, Pos = Vector3.new(-1232, 80, 3240)},
    {Name = "Marine Starter", Level = 1, Pos = Vector3.new(2490, 20, -1025)},
    {Name = "Desert", Level = 100, Pos = Vector3.new(-4500, 80, 2000)},
    {Name = "Sky", Level = 200, Pos = Vector3.new(300, 500, -500)},
    -- Thêm các đảo khác tùy theo cập nhật
}

-- Hàm tìm quái phù hợp nhất với level hiện tại
local function GetBestNPC()
    local best = nil
    local highestReward = 0
    for _, npc in pairs(workspace.Enemies:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
            local distance = (RootPart.Position - npc.HumanoidRootPart.Position).Magnitude
            if distance <= FarmRadius then
                -- Giả sử NPC có thuộc tính "Level" hoặc "RewardXP"
                local reward = npc:GetAttribute("RewardXP") or 0
                if reward > highestReward then
                    highestReward = reward
                    best = npc
                end
            end
        end
    end
    return best
end

-- Hàm tấn công quái
local function AttackNPC(npc)
    if not npc or not npc.Parent then return end
    local tool = Character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
    -- Gửi yêu cầu tấn công (click chuột)
    local args = {
        [1] = npc.HumanoidRootPart
    }
    game:GetService("ReplicatedStorage").Remotes.Attack:FireServer(unpack(args))
end

-- Hàm nhặt vật phẩm
local function CollectItems()
    for _, item in pairs(workspace.Items:GetChildren()) do
        if item:FindFirstChild("Handle") or item:FindFirstChild("MeshPart") then
            local distance = (RootPart.Position - item.Position).Magnitude
            if distance <= 20 then
                fireclickdetector(item:FindFirstChildOfClass("ClickDetector"))
            end
        end
    end
end

-- Hàm teleport tới đảo
local function TeleportToIsland(island)
    if island and island.Pos then
        RootPart.CFrame = CFrame.new(island.Pos)
        wait(1)
    end
end

-- Vòng lặp Auto Farm
local function FarmLoop()
    while AutoFarm and Character and Humanoid and Humanoid.Health > 0 do
        local target = GetBestNPC()
        if target then
            -- Di chuyển tới quái
            RootPart.CFrame = CFrame.new(target.HumanoidRootPart.Position + Vector3.new(0, 5, 0))
            wait(0.1)
            -- Tấn công
            AttackNPC(target)
        end
        if AutoCollect then
            CollectItems()
        end
        wait(FarmDelay)
    end
end

-- Bắt đầu / dừng Auto Farm
local function StartAutoFarm()
    if not AutoFarm then
        AutoFarm = true
        spawn(FarmLoop)
    end
end

local function StopAutoFarm()
    AutoFarm = false
end

-- Tạo các tab và button trong GUI
local FarmTab = Window:CreateTab("Auto Farm")
FarmTab:CreateToggle({
    Name = "Auto Farm",
    Callback = function(state)
        if state then
            StartAutoFarm()
        else
            StopAutoFarm()
        end
    end
})

FarmTab:CreateToggle({
    Name = "Auto Collect Items",
    Callback = function(state)
        AutoCollect = state
    end
})

FarmTab:CreateSlider({
    Name = "Farm Radius",
    Min = 500,
    Max = 5000,
    Default = 2000,
    Callback = function(value)
        FarmRadius = value
    end
})

FarmTab:CreateSlider({
    Name = "Attack Delay (s)",
    Min = 0.1,
    Max = 2,
    Default = 0.5,
    Callback = function(value)
        FarmDelay = value
    end
})

-- Tab Teleport
local TeleportTab = Window:CreateTab("Teleport")
for _, island in ipairs(Islands) do
    TeleportTab:CreateButton({
        Name = island.Name .. " (Lv." .. island.Level .. ")",
        Callback = function()
            TeleportToIsland(island)
        end
    })
end

-- Tab Utility
local UtilTab = Window:CreateTab("Utility")
UtilTab:CreateButton({
    Name = "Respawn",
    Callback = function()
        LocalPlayer.Character.Humanoid.Health = 0
        wait(2)
        -- Sau khi chết, tự động chờ respawn
    end
})

UtilTab:CreateButton({
    Name = "Reset Character",
    Callback = function()
        LocalPlayer.Character.Humanoid.Health = 0
    end
})

UtilTab:CreateButton({
    Name = "Bring Items to Me",
    Callback = function()
        for _, item in pairs(workspace.Items:GetChildren()) do
            if item:FindFirstChild("Handle") or item:FindFirstChild("MeshPart") then
                item:SetPrimaryPartCFrame(CFrame.new(RootPart.Position + Vector3.new(0, 2, 0)))
            end
        end
    end
})

-- Thông báo khi script được load
Library:Notification("Script loaded!", "Blox Fruits Script ready", 5)
